<% layout('/layouts/boilerplate') -%>

<div class="container py-4">
  <div class="row">
    <div class="col-12 col-md-10 col-lg-8 mx-auto">
      <div class="form-card">
        <div class="text-center mb-4">
          <div class="d-inline-flex align-items-center justify-content-center bg-danger bg-opacity-10 text-danger rounded-circle p-3 mb-3">
            <i class="fa-solid fa-pen-to-square fs-2"></i>
          </div>
          <h2 class="form-header-title">Edit Your Listing</h2>
          <p class="form-header-subtitle">Update property information, pricing, or change photos</p>
        </div>

        <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">
          <div class="mb-3">
            <label for="title" class="form-label">Property Title</label>
            <div class="input-group">
              <span class="input-group-text"><i class="fa-solid fa-heading"></i></span>
              <input
                name="listing[title]"
                id="title"
                value="<%= listing.title %>"
                type="text"
                class="form-control"
                required
              />
            </div>
            <div class="invalid-feedback">Please enter a valid title.</div>
          </div>

          <div class="mb-3">
            <label for="description" class="form-label">Description</label>
            <textarea name="listing[description]" id="description" class="form-control" rows="4" required><%= listing.description %></textarea>
            <div class="invalid-feedback">Please enter a short description.</div>
          </div>

          <% if(originalImageUrl) { %>
          <div class="mb-3">
            <label class="form-label d-block">Current Cover Image</label>
            <div class="p-2 border rounded-3 d-inline-block bg-light shadow-sm">
              <img src="<%= originalImageUrl %>" class="img-fluid rounded-2" style="max-height: 180px; object-fit: cover;" alt="Current Listing Image">
            </div>
          </div>
          <% } %>

          <div class="mb-4">
            <label for="image" class="form-label">Upload New Cover Image (Optional)</label>
            <div class="custom-dropzone mb-2" onclick="document.getElementById('image').click();">
              <i class="fa-solid fa-image text-danger fs-1 mb-2"></i>
              <h6 class="fw-bold mb-1">Click to select new image</h6>
              <p class="text-muted small mb-0">Leave blank to keep existing photo</p>
            </div>
            <input
              name="listing[image]"
              id="image"
              type="file"
              class="form-control d-none"
              onchange="if(this.files[0]) alert('New file selected: ' + this.files[0].name);"
            />
          </div>

          <div class="row">
            <div class="mb-3 col-md-5">
              <label for="price" class="form-label">Price per Night (&#8377;)</label>
              <div class="input-group">
                <span class="input-group-text">&#8377;</span>
                <input
                  name="listing[price]"
                  id="price"
                  value="<%= listing.price %>"
                  type="number"
                  class="form-control"
                  min="0"
                  required
                />
              </div>
              <div class="invalid-feedback">Please enter a valid price.</div>
            </div>

            <div class="mb-3 col-md-7">
              <label for="country" class="form-label">Country</label>
              <div class="input-group">
                <span class="input-group-text"><i class="fa-solid fa-earth-americas"></i></span>
                <input
                  name="listing[country]"
                  id="country"
                  value="<%= listing.country %>"
                  type="text"
                  class="form-control"
                  required
                />
              </div>
              <div class="invalid-feedback">Please enter a valid country name.</div>
            </div>
          </div>

          <div class="mb-4">
            <label for="location" class="form-label">City / Location</label>
            <div class="input-group">
              <span class="input-group-text"><i class="fa-solid fa-location-dot"></i></span>
              <input
                name="listing[location]"
                id="location"
                value="<%= listing.location %>"
                type="text"
                class="form-control"
                required
              />
            </div>
            <div class="invalid-feedback">Please enter a valid location.</div>
          </div>

          <button class="btn btn-form-submit py-3">
            <i class="fa-solid fa-check-circle me-2"></i> Save & Update Changes
          </button>
        </form>
      </div>
    </div>
  </div>
</div>
