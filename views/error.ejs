<% layout('/layouts/boilerplate') -%>

<div class="container py-5 my-4">
  <div class="row">
    <div class="col-12 col-md-8 col-lg-6 mx-auto text-center">
      <div class="card border-0 shadow-lg p-5" style="border-radius: var(--radius-xl); background: var(--bg-surface);">
        <div class="d-inline-flex align-items-center justify-content-center bg-danger bg-opacity-10 text-danger rounded-circle p-4 mx-auto mb-4" style="width: 90px; height: 90px;">
          <i class="fa-solid fa-triangle-exclamation fs-1"></i>
        </div>
        <h2 class="fw-bold mb-2">Oops! Something went wrong</h2>
        <p class="text-muted mb-4 fs-6">We encountered an issue processing your request.</p>
        
        <div class="alert alert-danger alert-custom text-start mb-4" role="alert">
          <i class="fa-solid fa-circle-exclamation fs-5 flex-shrink-0 text-danger"></i>
          <div>
            <strong>Error Details:</strong><br>
            <%= err.message %>
          </div>
        </div>

        <div class="d-flex justify-content-center gap-3">
          <a href="/listings" class="btn btn-auth-primary rounded-pill px-4 py-2">
            <i class="fa-solid fa-house me-2"></i> Back to All Stays
          </a>
        </div>
      </div>
    </div>
  </div>
</div>