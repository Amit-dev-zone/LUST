<% layout('/layouts/boilerplate') -%>

<div class="container py-5">
  <div class="row">
    <div class="col-12 col-sm-10 col-md-8 col-lg-5 mx-auto">
      <div class="form-card">
        <div class="text-center mb-4">
          <div class="d-inline-flex align-items-center justify-content-center bg-danger bg-opacity-10 text-danger rounded-circle p-3 mb-3">
            <i class="fa-solid fa-user-plus fs-2"></i>
          </div>
          <h2 class="form-header-title">Create an Account</h2>
          <p class="form-header-subtitle">Join Wanderlust to discover and host unique stays</p>
        </div>

        <form action="/signup" method="POST" class="needs-validation" novalidate>
          <div class="mb-3">
            <label for="username" class="form-label">Username</label>
            <div class="input-group">
              <span class="input-group-text"><i class="fa-regular fa-user"></i></span>
              <input name="username" id="username" placeholder="Choose a username" type="text" class="form-control" required>
            </div>
            <div class="invalid-feedback">Please enter a valid username.</div>
          </div>

          <div class="mb-3">
            <label for="email" class="form-label">Email Address</label>
            <div class="input-group">
              <span class="input-group-text"><i class="fa-regular fa-envelope"></i></span>
              <input name="email" id="email" placeholder="name@example.com" type="email" class="form-control" required>
            </div>
            <div class="invalid-feedback">Please enter a valid email address.</div>
          </div>

          <div class="mb-4">
            <label for="password" class="form-label">Password</label>
            <div class="input-group">
              <span class="input-group-text"><i class="fa-solid fa-lock"></i></span>
              <input name="password" id="password" placeholder="Create a strong password" type="password" class="form-control" required>
            </div>
            <div class="invalid-feedback">Please enter a password.</div>
          </div>

          <button class="btn btn-form-submit py-3 mb-3">
            <i class="fa-solid fa-user-plus me-2"></i> Create Account
          </button>

          <div class="text-center">
            <p class="text-muted fs-6 mb-0">Already have an account? <a href="/login" class="text-danger fw-bold text-decoration-underline">Log In</a></p>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>