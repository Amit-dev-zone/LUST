<% if (success && success.length) { %>
    <div class="alert alert-success alert-custom alert-dismissible fade show col-12 col-md-8 col-lg-6 mx-auto mb-4" role="alert">
        <i class="fa-solid fa-circle-check fs-4 text-success flex-shrink-0"></i>
        <div class="flex-grow-1"><%= success %></div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>

<% if (error && error.length) { %>
    <div class="alert alert-danger alert-custom alert-dismissible fade show col-12 col-md-8 col-lg-6 mx-auto mb-4" role="alert">
        <i class="fa-solid fa-circle-exclamation fs-4 text-danger flex-shrink-0"></i>
        <div class="flex-grow-1"><%= error %></div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>