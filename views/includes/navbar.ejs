<nav class="navbar navbar-expand-md sticky-top" id="mainNavbar">
  <div class="container-fluid px-lg-4">
    <a class="navbar-brand me-3" href="/listings" aria-label="Wanderlust Homepage">
      <i class="fa-regular fa-compass brand-icon"></i>
      <span>Wanderlust</span>
    </a>

    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNavAltMarkup"
      aria-controls="navbarNavAltMarkup"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <i class="fa-solid fa-bars-staggered fs-5 text-dark"></i>
    </button>

    <div class="collapse navbar-collapse mt-2 mt-md-0" id="navbarNavAltMarkup">
      <div class="navbar-nav me-auto">
        <a class="nav-link-custom" href="/listings">
          <i class="fa-solid fa-compass text-danger me-1"></i> Explore Stays
        </a>
      </div>

      <div class="search-container mx-auto my-2 my-md-0">
        <form class="d-flex position-relative align-items-center" action="/listings" method="GET" role="search" id="navbarSearchForm">
          <input 
            class="form-control search-inp" 
            type="search" 
            name="q" 
            id="searchInput"
            value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
            placeholder="Search destinations, beachfront villas, cabins..." 
            aria-label="Search destinations"
            autocomplete="off"
          >
          
          <span class="search-shortcut-badge d-none d-xl-inline-block" title="Press / to search">/</span>

          <% if (typeof searchQuery !== 'undefined' && searchQuery) { %>
            <button class="btn btn-search-clear" type="button" id="clearSearchBtn" title="Clear search" aria-label="Clear search">
              <i class="fa-solid fa-xmark"></i>
            </button>
          <% } %>

          <button class="btn btn-search" type="submit" aria-label="Submit search" title="Search stays">
            <i class="fa-solid fa-magnifying-glass btn-search-icon"></i>
            <span class="btn-search-text d-none d-lg-inline-block">Search</span>
          </button>
        </form>
      </div>

      <div class="navbar-nav ms-auto align-items-md-center gap-2">
        <a class="nav-link-custom me-md-1" href="/listings/new">
          <i class="fa-solid fa-house-medical text-danger"></i> Host Your Home
        </a>
        
        <% if (currUser) { %>
          <div class="d-flex align-items-center gap-2 ms-md-2 mt-2 mt-md-0">
            <div class="owner-pill mb-0" title="Logged in as <%= currUser.username %>">
              <span class="owner-avatar"><%= currUser.username.charAt(0).toUpperCase() %></span>
              <span class="d-inline fw-semibold"><%= currUser.username %></span>
            </div>
            <a class="btn btn-auth-secondary" href="/logout" aria-label="Log out of account">Log Out</a>
          </div>
        <% } else { %>
          <div class="d-flex align-items-center gap-2 ms-md-2 mt-2 mt-md-0">
            <a class="btn btn-auth-secondary" href="/login" aria-label="Log in">Log In</a>
            <a class="btn btn-auth-primary" href="/signup" aria-label="Sign up">Sign Up</a>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</nav>
